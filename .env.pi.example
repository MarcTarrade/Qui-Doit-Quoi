# Créez un sous-domaine gratuit sur https://www.duckdns.org.
# Indiquez uniquement la partie avant .duckdns.org.
DUCKDNS_SUBDOMAIN=monappli
DUCKDNS_TOKEN=replace-with-your-duckdns-token

# Identifiants PostgreSQL : choisissez des valeurs propres à votre installation.
POSTGRES_DB=quidoitquoi
POSTGRES_USER=quidoitquoi
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Générez une clé aléatoire avec : openssl rand -hex 32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAME_SITE=Lax
